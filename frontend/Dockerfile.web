# syntax=docker/dockerfile:1
# Despliegue local simple de la app de usuario (Expo web) servida como sitio
# estatico y conectada al backend ya desplegado en Render.
#
# Construir y arrancar (desde la raiz del repositorio):
#   docker compose -f docker-compose.web.yml up --build
# y abrir http://localhost:8081

# ---------- Etapa 1: build estatico de la app Expo web ----------
FROM node:24-alpine AS builder
WORKDIR /app

# Configuracion embebida en el bundle (las variables EXPO_PUBLIC_* se inyectan
# en tiempo de compilacion). Por defecto apunta al backend desplegado en Render;
# puede sobreescribirse con --build-arg.
#
# IMPORTANTE: la clave de Google Maps NUNCA se incrusta aqui (este fichero se
# versiona y la clave quedaria expuesta en el repositorio). Debe pasarse en
# tiempo de build, por ejemplo:
#   docker build --build-arg EXPO_PUBLIC_GOOGLE_MAPS_KEY="$EXPO_PUBLIC_GOOGLE_MAPS_KEY" ...
# o mediante docker-compose, que la inyecta desde el entorno del host (.env).
ARG EXPO_PUBLIC_API_URL=https://bargain-free-api.onrender.com/api/v1
ARG EXPO_PUBLIC_GOOGLE_MAPS_KEY=
ARG EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=9b2a3c03b0a10f4025e8fe57
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL \
    EXPO_PUBLIC_GOOGLE_MAPS_KEY=$EXPO_PUBLIC_GOOGLE_MAPS_KEY \
    EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=$EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID \
    CI=1 \
    EXPO_NO_TELEMETRY=1

# Dependencias (capa cacheable mientras no cambien los manifiestos)
COPY package.json package-lock.json ./
RUN npm ci

# Codigo fuente y exportacion estatica a /app/dist
COPY . .
RUN npx expo export --platform web --output-dir dist

# ---------- Etapa 2: servidor estatico nginx ----------
FROM nginx:1.27-alpine AS runtime
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
